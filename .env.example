EXPO_PUBLIC_APP_ENV=development

# Optional: Supabase Realtime is used only for WebRTC signaling and presence.
# Use a publishable/anon key. Never place a service_role or secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: self-hosted ephemeral signaling server.
# Example for another computer on the same LAN: ws://192.168.1.10:8787
EXPO_PUBLIC_SYNPEER_SIGNALING_URL=

# Used only by `npm run signaling`.
SYNPEER_SIGNALING_HOST=0.0.0.0
SYNPEER_SIGNALING_PORT=8787
