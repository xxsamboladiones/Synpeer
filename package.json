{
  "name": "synpeer",
  "version": "1.0.0",
  "description": "Experimental local-first peer-to-peer social network built with TypeScript, Expo and WebRTC.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxsamboladiones/Synpeer.git"
  },
  "bugs": {
    "url": "https://github.com/xxsamboladiones/Synpeer/issues"
  },
  "homepage": "https://github.com/xxsamboladiones/Synpeer#readme",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/bootstrap": "^12.0.25",
    "@libp2p/tcp": "^11.0.22",
    "@libp2p/websockets": "^10.1.15",
    "@multiformats/multiaddr": "^13.0.3",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/ed25519": "^3.1.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "expo": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-crypto": "^57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.3",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "libp2p": "^3.3.4",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.80.0",
    "react-native": "0.86.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^57.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.1",
    "prettier": "^3.9.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "signaling": "node scripts/signaling-server.js",
    "export:web": "expo export --platform web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm test -- --runInBand",
    "security:scan": "node scripts/check-secrets.js",
    "verify": "npm run security:scan && npm run check && npm run export:web",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:mesh": "playwright test --config playwright.config.ts e2e/mesh",
    "test:e2e:mesh:repeat": "playwright test --config playwright.config.ts e2e/mesh --repeat-each=3"
  },
  "private": true
}
